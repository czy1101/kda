{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pre-registered compiler mechanism hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "parent_capture",
    "statement",
    "change",
    "expected_effect",
    "risks",
    "disproof",
    "predictions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "not": {
        "const": "baseline"
      }
    },
    "parent_capture": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "change": {
      "type": "string",
      "minLength": 1
    },
    "expected_effect": {
      "type": "string",
      "minLength": 1
    },
    "risks": {
      "type": "string",
      "minLength": 1
    },
    "disproof": {
      "type": "string",
      "minLength": 1
    },
    "predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workload",
          "kernel",
          "kind",
          "name",
          "relation"
        ],
        "properties": {
          "workload": {
            "type": "string",
            "minLength": 1
          },
          "kernel": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "metric",
              "artifact"
            ]
          },
          "relation": {
            "enum": [
              "decrease",
              "increase",
              "equal",
              "nonincrease",
              "nondecrease",
              "changed",
              "unchanged"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "metric"
                }
              }
            },
            "then": {
              "properties": {
                "relation": {
                  "enum": [
                    "decrease",
                    "increase",
                    "equal",
                    "nonincrease",
                    "nondecrease"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "relation": {
                  "enum": [
                    "changed",
                    "unchanged"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
