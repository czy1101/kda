{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KDA live analysis capability evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated_at",
    "backend_profile",
    "transport",
    "environment_fingerprint",
    "policy",
    "status",
    "selected",
    "tools"
  ],
  "properties": {
    "version": {"const": 1},
    "generated_at": {"type": "string"},
    "backend_profile": {"type": ["string", "null"]},
    "transport": {"enum": ["local", "ssh"]},
    "environment_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy": {"enum": ["auto", "disabled", "required"]},
    "status": {"enum": ["complete", "no_tool_available", "disabled"]},
    "selected": {"type": ["string", "null"]},
    "disabled_reason": {"type": "string"},
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "priority",
          "available",
          "probe_exit_code",
          "capabilities"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "priority": {"type": "integer"},
          "available": {"type": "boolean"},
          "probe_exit_code": {"type": "integer"},
          "probe_error": {"type": "string"},
          "version_exit_code": {"type": "integer"},
          "version": {"type": "string"},
          "capabilities": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
